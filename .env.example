# ====== Publik (boleh terlihat di browser) ======
# URL website setelah deploy, tanpa garis miring di akhir. Contoh: https://baitulfadli.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Publishable key (sb_publishable_...) atau anon key lama
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Username bot Telegram TANPA @, contoh: BaitulFadliBot
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=BaitulFadliBot

# ====== Rahasia (HANYA server, jangan pernah diberi prefix NEXT_PUBLIC_) ======
# Secret key (sb_secret_...) atau service_role key lama
SUPABASE_SECRET_KEY=sb_secret_xxx
# Token dari @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-xxx
# String acak panjang (min 32 karakter) untuk memverifikasi webhook Telegram. Hanya huruf, angka, _ dan -
TELEGRAM_WEBHOOK_SECRET=ganti-dengan-string-acak-panjang
# String acak panjang (min 32 karakter) untuk mengamankan endpoint cron
CRON_SECRET=ganti-dengan-string-acak-panjang-lain

# Hanya untuk pengujian lokal dengan server tiruan Telegram. Kosongkan di produksi.
# TELEGRAM_API_BASE_URL=http://127.0.0.1:4010
